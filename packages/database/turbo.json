{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // While developing, regenerate the Prisma client whenever schema.prisma changes.
    "dev": {
      "with": ["dev:generate"]
    },
    "dev:generate": {
      // Start the watcher only after the one-shot generate finished: both write src/generated.
      "dependsOn": ["db:generate"],
      "cache": false,
      "persistent": true
    }
  }
}
