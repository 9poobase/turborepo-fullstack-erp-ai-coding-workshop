// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PURCHASING_OFFICER
  STORE_EMPLOYEE
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash String
  role         Role
  /// The store a user belongs to (its code). A store employee has exactly one; other roles have none.
  storeCode    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Store {
  id        String   @id @default(cuid())
  /// Unique store code across the organization, e.g. "B01".
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(cuid())
  /// Unique supplier code across the organization, e.g. "SUP01".
  code      String   @unique
  name      String
  /// Free-text contact details (person, phone, email).
  contact   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id   String @id @default(cuid())
  /// Unique SKU across the organization, e.g. "SKU001". Immutable once a transaction exists.
  sku  String @unique
  name String
  /// Free-text product category, e.g. "เครื่องดื่ม".
  category String
  /// Base unit of sale, e.g. "แพ็ค". One base unit per SKU.
  unit     String
  /// Selling price in Thai baht. Non-negative; two decimal places.
  sellingPrice Decimal @db.Decimal(12, 2)
  /// Inactive products stay searchable in history but cannot be added to new documents.
  active   Boolean @default(true)
  /// Per-store reorder thresholds. A store with no row has no configured threshold.
  thresholds ProductStoreThreshold[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The reorder threshold for one product at one store. Quantities are whole numbers.
model ProductStoreThreshold {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Store code this threshold applies to, e.g. "B01".
  storeCode String
  /// Reorder threshold quantity. Non-negative whole number.
  threshold Int

  @@unique([productId, storeCode])
}
