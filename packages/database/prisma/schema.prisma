// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PURCHASING_OFFICER
  STORE_EMPLOYEE
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash String
  role         Role
  /// The store a user belongs to (its code). A store employee has exactly one; other roles have none.
  storeCode    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Store {
  id        String   @id @default(cuid())
  /// Unique store code across the organization, e.g. "B01".
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(cuid())
  /// Unique supplier code across the organization, e.g. "SUP01".
  code      String   @unique
  name      String
  /// Free-text contact details (person, phone, email).
  contact   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id   String @id @default(cuid())
  /// Unique SKU across the organization, e.g. "SKU001". Immutable once a transaction exists.
  sku  String @unique
  name String
  /// Free-text product category, e.g. "เครื่องดื่ม".
  category String
  /// Base unit of sale, e.g. "แพ็ค". One base unit per SKU.
  unit     String
  /// Selling price in Thai baht. Non-negative; two decimal places.
  sellingPrice Decimal @db.Decimal(12, 2)
  /// Inactive products stay searchable in history but cannot be added to new documents.
  active   Boolean @default(true)
  /// Per-store reorder thresholds. A store with no row has no configured threshold.
  thresholds ProductStoreThreshold[]
  /// Authoritative per-store stock balances.
  balances   StockBalance[]
  /// Append-only movement ledger entries for this product.
  movements  StockMovement[]
  /// Purchase order lines that order this product.
  purchaseOrderLines PurchaseOrderLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The reorder threshold for one product at one store. Quantities are whole numbers.
model ProductStoreThreshold {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Store code this threshold applies to, e.g. "B01".
  storeCode String
  /// Reorder threshold quantity. Non-negative whole number.
  threshold Int

  @@unique([productId, storeCode])
}

/// How a stock movement came to be. The append-only ledger records one of these per entry.
/// This release introduces the shape; later stock-writing tickets add the remaining sources.
enum StockMovementType {
  /// Goods receipt increased stock.
  RECEIPT
  /// Sale decreased stock.
  SALE
  /// Manager adjustment (increase or decrease) with a mandatory reason.
  ADJUSTMENT
  /// Opening balance recorded when a product first stocks at a store.
  OPENING
}

/// The authoritative current quantity for one product at one store. Never negative. One row per
/// (product, store). Later stock-writing tickets keep this in step with the StockMovement ledger
/// inside a single transaction; this ticket seeds opening quantities directly.
model StockBalance {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Store code this balance belongs to, e.g. "B01".
  storeCode String
  /// Current on-hand quantity. Non-negative whole number.
  quantity  Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, storeCode])
}

/// Append-only movement ledger. Every stock increase or decrease writes one immutable row here
/// recording the product, store, signed quantity change, the balance before and after, the
/// movement type, an optional source-document reference, the actor, and when it happened.
/// There is no edit or delete path: the ledger is the audit trail every stock-writing ticket reuses.
model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Store code this movement applies to, e.g. "B01".
  storeCode      String
  /// Signed change applied to the balance: positive for an increase, negative for a decrease.
  quantityChange Int
  /// On-hand quantity immediately before this movement.
  balanceBefore  Int
  /// On-hand quantity immediately after this movement (balanceBefore + quantityChange).
  balanceAfter   Int
  movementType   StockMovementType
  /// Reference to the document that caused the movement, e.g. "GR-0001"; null for an opening balance.
  sourceDocument String?
  /// The user who caused the movement. Null only for system-seeded opening balances.
  actorId        String?
  /// When the movement happened. No updatedAt: rows are immutable once written.
  createdAt      DateTime          @default(now())

  @@index([productId, storeCode])
}

/// Lifecycle of a purchase order (PO-02). Drafting only ever creates DRAFT rows; the status
/// machine that moves an order through the other states is a later ticket.
enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  COMPLETED
  REJECTED
  CANCELLED
}

/// An order placed with one supplier for one destination store. Supplier and store are referenced
/// by code, with their names snapshotted so later master-data edits never rewrite the document.
/// Creating or editing an order never touches stock.
model PurchaseOrder {
  id                  String              @id @default(cuid())
  status              PurchaseOrderStatus @default(DRAFT)
  /// Supplier code at the time the draft was saved, e.g. "SUP01".
  supplierCode        String
  supplierName        String
  /// Destination store code, e.g. "B01".
  storeCode           String
  storeName           String
  /// Calendar date the goods are expected. Date only: no time zone to drift.
  expectedReceiptDate DateTime            @db.Date
  /// The purchasing officer who created the order.
  createdById         String
  lines               PurchaseOrderLine[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([createdAt])
}

/// One product on a purchase order. The product's SKU, name and unit are snapshots.
model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku             String
  productName     String
  unit            String
  /// Ordered quantity. Positive whole number.
  quantity        Int
  /// Purchase price per unit in Thai baht. Non-negative; two decimal places.
  unitPrice       Decimal       @db.Decimal(12, 2)

  /// A product appears at most once per order.
  @@unique([purchaseOrderId, productId])
}
