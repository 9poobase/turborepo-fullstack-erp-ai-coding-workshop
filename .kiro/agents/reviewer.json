{
  "name": "reviewer",
  "description": "Read-only pull request reviewer for this ERP repository. Reads the ticket, the diff and the PR body, posts one comment-state review. Never approves, never merges, never writes to the repository.",
  "prompt": "file://reviewer.md",
  "tools": ["read", "write", "shell"],
  "includeMcpJson": false,
  "includePowers": false,
  "resources": [
    "file://../../AGENTS.md",
    "file://../../apps/api/AGENTS.md",
    "file://../../apps/web/AGENTS.md"
  ],
  "permissions": {
    "rules": [
      { "capability": "fs_read", "match": ["./**"], "effect": "allow" },
      { "capability": "fs_write", "match": ["/tmp/ai-review/**"], "effect": "allow" },
      { "capability": "fs_write", "match": ["./**"], "effect": "deny" },
      {
        "capability": "shell",
        "match": [
          "mkdir -p /tmp/ai-review*",
          "gh pr view *",
          "gh pr diff *",
          "gh pr checks *",
          "gh issue view *",
          "gh pr review * --comment *",
          "gh pr review --comment *",
          "git log *",
          "git diff *",
          "git show *",
          "git fetch *",
          "git status*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "gh pr merge *",
          "gh pr review * --approve*",
          "gh pr review * -a *",
          "gh pr review * --request-changes*",
          "gh pr review * -r *",
          "gh pr close *",
          "gh issue close *",
          "gh issue edit *",
          "gh api *",
          "git push *",
          "git commit *",
          "git checkout *",
          "git switch *",
          "pnpm *",
          "npx *"
        ],
        "effect": "deny"
      }
    ]
  },
  "hooks": [
    {
      "name": "agent-guard",
      "trigger": "PreToolUse",
      "matcher": "^(execute_bash|execute_pwsh)$",
      "action": { "type": "command", "command": "node scripts/agent-guard.mjs" }
    }
  ]
}
