{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Dev loop (separate from `build`, which writes dist/):
    //   dev:prepare  compile src/ -> .dev/ once
    //   dev:compile  keep compiling in watch mode
    //   dev          run .dev/main.js with `node --watch`; it restarts when .dev/ or a
    //                shared package's dist/ changes
    "dev": {
      "dependsOn": ["^build", "dev:prepare"],
      "with": ["dev:compile"]
    },
    "dev:prepare": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev:compile": {
      "dependsOn": ["^build", "dev:prepare"],
      "cache": false,
      "persistent": true
    }
  }
}
